# Local loopback-only Mosquitto demo broker; start it with mosquitto-demo.conf.
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_TOPIC=meters/+/readings
MQTT_CLIENT_ID=meter-dashboard-demo
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
MQTT_DEMO_INTERVAL_SECONDS=5

# Application
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false
# DATABASE_PATH=instance/meter_readings.sqlite3
